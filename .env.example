# HTTP port
PORT=3000
# SQLite file (directory is created if missing). Use a persistent disk in production.
DB_FILE=./data/funnel.sqlite
# Directory with funnel-*.json loaded on boot (all stored as drafts; the one with "status": "published" is activated if nothing is active yet)
CONFIGS_DIR=./configs
# Optional. When set, /admin, /dashboard and their APIs require this token (header x-admin-token or ?token=).
ADMIN_TOKEN=
