{
  "name": "@funnel/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/seed.ts src/cli.ts --bundle --platform=node --format=esm --outdir=dist --sourcemap --external:better-sqlite3 --external:express --external:zod",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "publish-version": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@funnel/shared": "*",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
